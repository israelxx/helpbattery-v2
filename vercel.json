{
  "headers": [
    {"source": "/assets/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ],
  "redirects": [
    {"source": "/(.*)", "has": [{"type": "host", "value": "helpbattery-v2.vercel.app"}], "destination": "https://www.helpbattery.pt/$1", "permanent": true},
    {"source": "/contacto{/}?", "destination": "/#contacto", "statusCode": 301},
    {"source": "/contato{/}?", "destination": "/#contacto", "statusCode": 301},
    {"source": "/contactos{/}?", "destination": "/#contacto", "statusCode": 301},
    {"source": "/sobre{/}?", "destination": "/#sobre", "statusCode": 301},
    {"source": "/lojas{/}?", "destination": "/#lojas", "statusCode": 301},
    {"source": "/servicos{/}?", "destination": "/#servicos", "statusCode": 301},
    {"source": "/a-empresa{/}?", "destination": "/#sobre", "statusCode": 301},
    {"source": "/blog/(.*)", "destination": "/", "statusCode": 301},
    {"source": "/blog{/}?", "destination": "/", "statusCode": 301},
    {"source": "/category/(.*)", "destination": "/", "statusCode": 301},
    {"source": "/author/(.*)", "destination": "/", "statusCode": 301},
    {"source": "/:year(\\d{4})/(.*)", "destination": "/", "statusCode": 301},
    {"source": "/guia-completo-de-manutencao-preditiva{/}?", "destination": "/", "statusCode": 301},
    {"source": "/tendencias-de-iot-em-2024{/}?", "destination": "/", "statusCode": 301},
    {"source": "/caso-de-sucesso-implementacao-de-iot-na-industria{/}?", "destination": "/", "statusCode": 301}
  ]
}
